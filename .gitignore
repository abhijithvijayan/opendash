/android/app/release

# Kotlin Gradle plugin daemon session data
/android/.kotlin/

# Widget Preview related
.widget_preview/

# Pulled scooter logs (analytics, bus/burst/raw CAN captures). These may hold
# identifiers (VIN, MAC, serials) from before capture-time masking shipped —
# never commit them. Covers logs/, logs/ride-*, logs/logs-*, etc.
logs/
logs-*/
*.jsonl

# Release signing: never commit a key.
key.properties
*.jks
*.keystore
*.p12

# Release output of scripts/release.sh
/dist/

# Kept on the maintainer's machine only: research notes, audits, design
# notes, agent instructions, and files taken from the stock software for
# reference. None of it is needed to build, test or install OpenDash.
/docs/
/schemas/
/local/
/research/
CLAUDE.md
.claude/
.superpowers/
__pycache__/

# Cloudflare wrangler local state
.wrangler/
